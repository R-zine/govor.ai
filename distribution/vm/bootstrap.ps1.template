$ErrorActionPreference = 'Stop'
$seed = Get-PSDrive -PSProvider FileSystem |
    Where-Object { Test-Path (Join-Path $_.Root 'govor-m8-seed.marker') } |
    Select-Object -First 1
if (-not $seed) { throw 'The govor.ai provisioning seed is unavailable.' }

$evidenceRoot = 'C:\GovorM8'
New-Item -ItemType Directory -Path $evidenceRoot -Force | Out-Null
$transcript = Join-Path $evidenceRoot 'bootstrap.log'
Start-Transcript -LiteralPath $transcript -Force
try {
    $deadline = (Get-Date).AddMinutes(5)
    do {
        $profile = Get-NetConnectionProfile -ErrorAction SilentlyContinue |
            Where-Object { $_.IPv4Connectivity -ne 'Disconnected' } |
            Select-Object -First 1
        if ($profile) { break }
        Start-Sleep -Seconds 2
    } while ((Get-Date) -lt $deadline)
    if (-not $profile) { throw 'The VM network did not become ready.' }
    Set-NetConnectionProfile -InterfaceIndex $profile.InterfaceIndex -NetworkCategory Private

    $server = Get-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0'
    if ($server.State -ne 'Installed') {
        Add-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0' | Out-Null
    }
    Set-Service -Name sshd -StartupType Automatic
    Start-Service -Name sshd
    if (-not (Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue)) {
        New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server (sshd)' `
            -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 `
            -Profile Private | Out-Null
    }

    $sshDirectory = 'C:\ProgramData\ssh'
    New-Item -ItemType Directory -Path $sshDirectory -Force | Out-Null
    $authorizedKeys = Join-Path $sshDirectory 'administrators_authorized_keys'
    [IO.File]::WriteAllText($authorizedKeys, "{{SSH_PUBLIC_KEY}}`n", (New-Object Text.UTF8Encoding($false)))
    & icacls.exe $authorizedKeys /inheritance:r /grant:r 'SYSTEM:F' 'Administrators:F' | Out-Null
    if ($LASTEXITCODE -ne 0) { throw 'Unable to protect the SSH authorized-keys file.' }

    powercfg.exe /hibernate off
    powercfg.exe /change standby-timeout-ac 0
    powercfg.exe /change monitor-timeout-ac 0

    $inventory = [ordered]@{
        status = 'ready'
        provisioned_at = (Get-Date).ToUniversalTime().ToString('o')
        computer_name = $env:COMPUTERNAME
        windows_product_name = (Get-ComputerInfo -Property WindowsProductName).WindowsProductName
        windows_version = [Environment]::OSVersion.Version.ToString()
        os_build = [Environment]::OSVersion.Version.Build
        architecture = $env:PROCESSOR_ARCHITECTURE
        account = [Security.Principal.WindowsIdentity]::GetCurrent().Name
        network_category = 'Private'
        openssh_server = 'installed'
    }
    $json = ($inventory | ConvertTo-Json -Depth 4) + "`n"
    [IO.File]::WriteAllText((Join-Path $evidenceRoot 'provisioning.json'), $json, (New-Object Text.UTF8Encoding($false)))
}
catch {
    $failure = [ordered]@{
        status = 'failed'
        failed_at = (Get-Date).ToUniversalTime().ToString('o')
        message = $_.Exception.Message
    }
    [IO.File]::WriteAllText(
        (Join-Path $evidenceRoot 'provisioning.json'),
        (($failure | ConvertTo-Json -Depth 4) + "`n"),
        (New-Object Text.UTF8Encoding($false))
    )
    throw
}
finally {
    Stop-Transcript
}
