; Active govor.ai renderer project. Godot 4.7.2 .NET is pinned by scripts/common.ps1.
; Edit through Godot where practical; keep renderer logic independent of lesson policy.

config_version=5

[application]

config/name="govor.ai"
run/main_scene="res://Scenes/MediaProof.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://Assets/Brand/govor-icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Govor.Renderer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
