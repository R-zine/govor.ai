{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govor.ai/contracts/v1/environment-definition.schema.json",
  "title": "govor.ai procedural environment definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "environment_id", "display_name", "scene_id", "camera_preset",
    "lighting_preset", "transition", "avatar_position", "avatar_yaw_degrees", "objects"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment_id": { "$ref": "#/$defs/slug" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scene_id": { "$ref": "#/$defs/slug" },
    "camera_preset": { "enum": ["counter", "conversation", "wide"] },
    "lighting_preset": { "enum": ["warm", "daylight", "terminal", "home"] },
    "transition": { "enum": ["fade", "cut"] },
    "avatar_position": { "$ref": "#/$defs/position" },
    "avatar_yaw_degrees": { "type": "number", "minimum": -360, "maximum": 360 },
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/object" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$", "maxLength": 64
    },
    "position": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -20, "maximum": 20 },
        "y": { "type": "number", "minimum": -20, "maximum": 20 },
        "z": { "type": "number", "minimum": -20, "maximum": 20 }
      }
    },
    "size": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": 0.05, "maximum": 20 },
        "y": { "type": "number", "minimum": 0.05, "maximum": 20 },
        "z": { "type": "number", "minimum": 0.05, "maximum": 20 }
      }
    },
    "object": {
      "type": "object", "additionalProperties": false,
      "required": [
        "instance_id", "primitive", "size", "color", "position", "yaw_degrees", "scale"
      ],
      "properties": {
        "instance_id": {
          "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "maxLength": 64
        },
        "primitive": { "enum": ["box", "cylinder", "sphere"] },
        "size": { "$ref": "#/$defs/size" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "position": { "$ref": "#/$defs/position" },
        "yaw_degrees": { "type": "number", "minimum": -360, "maximum": 360 },
        "scale": { "type": "number", "minimum": 0.1, "maximum": 5 }
      }
    }
  }
}
