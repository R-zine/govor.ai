{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govor.ai/contracts/v1/message-envelope.schema.json",
  "title": "MessageEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "message_type", "correlation_id", "payload"],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "message_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    }
  }
}
