{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govor.ai/contracts/v1/application-patch-manifest.schema.json",
  "title": "govor.ai signed application patch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "patch_id",
    "created_at_utc",
    "from_version",
    "target_version",
    "files",
    "android"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "patch_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "from_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "target_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/addFile"
          },
          {
            "$ref": "#/$defs/replaceFile"
          },
          {
            "$ref": "#/$defs/deleteFile"
          }
        ]
      }
    },
    "android": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/androidPayload"
        }
      ]
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8589934592
    },
    "addFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "action": {
          "const": "add"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "replaceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "old_size", "old_sha256", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "action": {
          "const": "replace"
        },
        "old_size": {
          "$ref": "#/$defs/size"
        },
        "old_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "deleteFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "old_size", "old_sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "action": {
          "const": "delete"
        },
        "old_size": {
          "$ref": "#/$defs/size"
        },
        "old_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "androidPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "application_id",
        "version_code",
        "version_name",
        "signer_sha256",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^android/[A-Za-z0-9._-]+\\.apk$"
        },
        "application_id": {
          "const": "ai.govor.app"
        },
        "version_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2100000000
        },
        "version_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "signer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
