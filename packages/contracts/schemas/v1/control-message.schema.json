{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govor.ai/contracts/v1/control-message.schema.json",
  "title": "govor.ai control message",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "message_type", "correlation_id", "payload"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "message_type": {
      "enum": [
        "session.start",
        "lesson.catalog.request",
        "lesson.catalog",
        "session.state",
        "session.cancel",
        "session.retry",
        "session.ended",
        "teacher.turn",
        "teacher.playback_completed",
        "teacher.word_replay_requested",
        "teacher.word_audio",
        "learner.recording_started",
        "learner.recording_submitted",
        "learner.transcript",
        "renderer.ready",
        "renderer.teacher_profile_selected",
        "renderer.command",
        "renderer.ack",
        "error"
      ]
    },
    "correlation_id": { "type": "string", "format": "uuid" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "message_type": { "const": "lesson.catalog.request" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/lessonCatalogRequest" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "lesson.catalog" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/lessonCatalog" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "session.start" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/sessionStart" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "session.state" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/sessionState" } } }
    },
    {
      "if": {
        "properties": {
          "message_type": { "enum": ["session.retry"] }
        }
      },
      "then": { "properties": { "payload": { "$ref": "#/$defs/sessionScoped" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "session.cancel" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/sessionCancel" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "session.ended" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/sessionEnded" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "teacher.turn" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/teacherTurn" } } }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "teacher.playback_completed" } }
      },
      "then": { "properties": { "payload": { "$ref": "#/$defs/playbackCompleted" } } }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "teacher.word_replay_requested" } }
      },
      "then": { "properties": { "payload": { "$ref": "#/$defs/wordReplayRequest" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "teacher.word_audio" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/wordAudio" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "learner.recording_started" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/recordingStarted" } } }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "learner.recording_submitted" } }
      },
      "then": { "properties": { "payload": { "$ref": "#/$defs/recordingSubmitted" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "learner.transcript" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/transcript" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "renderer.ready" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/rendererReady" } } }
    },
    {
      "if": {
        "properties": { "message_type": { "const": "renderer.teacher_profile_selected" } }
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/rendererTeacherProfileSelected" } }
      }
    },
    {
      "if": { "properties": { "message_type": { "const": "renderer.command" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/rendererCommand" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "renderer.ack" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/rendererAck" } } }
    },
    {
      "if": { "properties": { "message_type": { "const": "error" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/error" } } }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sessionIdProperty": { "session_id": { "$ref": "#/$defs/uuid" } },
    "sessionScoped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id"],
      "properties": { "session_id": { "$ref": "#/$defs/uuid" } }
    },
    "lessonCatalogRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "lessonCatalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "title", "description", "display_order"],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "maxLength": 64
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "display_order": { "type": "integer", "minimum": 0, "maximum": 9999 }
      }
    },
    "lessonCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_scenario_id", "lessons"],
      "properties": {
        "default_scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "maxLength": 64
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/lessonCatalogItem" }
        }
      }
    },
    "sessionStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id"],
      "properties": {
        "client_id": { "$ref": "#/$defs/uuid" },
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "maxLength": 64,
          "default": "cafe-ordering"
        },
        "english_locale": {
          "enum": ["en-GB", "en-US"],
          "default": "en-GB"
        },
        "spaced_review_enabled": { "type": "boolean", "default": false }
      }
    },
    "sessionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "state", "event_id"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "state": {
          "enum": [
            "disconnected", "discovering", "pairing", "connecting", "ready",
            "teacher_speaking", "awaiting_learner", "recording", "processing",
            "reconnecting", "recoverable_error", "fatal_error", "ending"
          ]
        },
        "event_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "sessionCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "reason"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "reason": { "enum": ["user", "disconnect", "timeout"] }
      }
    },
    "sessionEnded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "reason"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "reason": { "enum": ["cancelled", "completed", "disconnected"] }
      }
    },
    "playbackCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "turn_id"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "turn_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "wordReplayRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "turn_id", "word_index", "playback_rate"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "turn_id": { "$ref": "#/$defs/uuid" },
        "word_index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "playback_rate": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
      }
    },
    "recordingStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "utterance_id"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "utterance_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "recordingSubmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "utterance_id", "duration_us", "audio_reference"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "utterance_id": { "$ref": "#/$defs/uuid" },
        "duration_us": { "type": "integer", "minimum": 1, "maximum": 30000000 },
        "audio_reference": { "const": "webrtc" }
      }
    },
    "teacherTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id", "turn_id", "text", "locale", "provider_id", "audio_format",
        "sample_rate_hz", "duration_us", "audio_base64", "pronunciations",
        "word_alignment", "phoneme_alignment", "fallback_used"
      ],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "turn_id": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "maxLength": 16 },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "audio_format": { "const": "wav" },
        "sample_rate_hz": { "enum": [16000, 22050, 24000, 48000] },
        "duration_us": { "type": "integer", "minimum": 1, "maximum": 30000000 },
        "audio_base64": { "type": "string", "minLength": 4, "maxLength": 2000060 },
        "pronunciations": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/pronunciation" }
        },
        "word_alignment": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "maxItems": 256,
              "items": { "$ref": "#/$defs/wordAlignment" }
            }
          ]
        },
        "phoneme_alignment": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "maxItems": 2048,
              "items": { "$ref": "#/$defs/phonemeAlignment" }
            }
          ]
        },
        "fallback_used": { "type": "boolean" },
        "lesson_progress": { "$ref": "#/$defs/lessonProgress" }
      }
    },
    "lessonProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id", "scenario_title", "exercise_number", "exercise_count",
        "successful_exercises", "attempts_on_exercise", "difficulty", "status",
        "resumed", "difficulty_change_reason"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "maxLength": 64
        },
        "scenario_title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "exercise_number": { "type": "integer", "minimum": 1, "maximum": 64 },
        "exercise_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "successful_exercises": { "type": "integer", "minimum": 0, "maximum": 64 },
        "attempts_on_exercise": { "type": "integer", "minimum": 0, "maximum": 100 },
        "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
        "status": { "enum": ["in_progress", "completed"] },
        "resumed": { "type": "boolean" },
        "difficulty_change_reason": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["repeated_difficulty", "consistent_first_try_success"] }
          ]
        }
      }
    },
    "pronunciation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "start_char", "end_char", "ipa", "locale", "explanation"],
      "properties": {
        "word": { "type": "string", "minLength": 1, "maxLength": 128 },
        "start_char": { "type": "integer", "minimum": 0, "maximum": 2047 },
        "end_char": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "ipa": { "type": "string", "minLength": 1, "maxLength": 256 },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "maxLength": 16 },
        "explanation": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 512 }
          ]
        }
      }
    },
    "wordAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_index", "start_us", "end_us"],
      "properties": {
        "word_index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "start_us": { "type": "integer", "minimum": 0, "maximum": 30000000 },
        "end_us": { "type": "integer", "minimum": 1, "maximum": 30000000 }
      }
    },
    "phonemeAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_index", "symbol", "start_us", "end_us"],
      "properties": {
        "word_index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 16 },
        "start_us": { "type": "integer", "minimum": 0, "maximum": 30000000 },
        "end_us": { "type": "integer", "minimum": 1, "maximum": 30000000 }
      }
    },
    "wordAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id", "turn_id", "word_index", "word", "locale", "provider_id",
        "audio_format", "sample_rate_hz", "duration_us", "audio_base64", "fallback_used"
      ],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "turn_id": { "$ref": "#/$defs/uuid" },
        "word_index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "word": { "type": "string", "minLength": 1, "maxLength": 128 },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "maxLength": 16 },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "audio_format": { "const": "wav" },
        "sample_rate_hz": { "enum": [16000, 22050, 24000, 48000] },
        "duration_us": { "type": "integer", "minimum": 1, "maximum": 30000000 },
        "audio_base64": { "type": "string", "minLength": 4, "maxLength": 2000060 },
        "fallback_used": { "type": "boolean" }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "utterance_id", "text", "locale", "provider_id"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "utterance_id": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "maxLength": 16 },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "rendererReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer_id", "renderer_kind", "protocol_version"],
      "properties": {
        "renderer_id": { "$ref": "#/$defs/uuid" },
        "renderer_kind": { "const": "godot" },
        "protocol_version": { "const": "1.0" }
      }
    },
    "rendererTeacherProfileSelected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id"],
      "properties": {
        "profile_id": { "enum": ["elena", "amira", "daniel"] }
      }
    },
    "rendererCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "command_id", "action", "media_start_us", "duration_us"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "command_id": { "$ref": "#/$defs/uuid" },
        "action": {
          "enum": [
            "session_started", "teacher_speaking", "awaiting_learner", "recording",
            "processing", "reset"
          ]
        },
        "media_start_us": { "type": "integer", "minimum": 0 },
        "duration_us": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 30000000 }
          ]
        },
        "scene": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sceneSpecification" }]
        },
        "avatar_animation": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/avatarAnimation" }]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["scene"],
            "properties": { "scene": { "type": "object" } }
          },
          "then": { "properties": { "action": { "const": "session_started" } } }
        },
        {
          "if": {
            "required": ["avatar_animation"],
            "properties": { "avatar_animation": { "type": "object" } }
          },
          "then": { "properties": { "action": { "const": "teacher_speaking" } } }
        }
      ]
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -20, "maximum": 20 },
        "y": { "type": "number", "minimum": -20, "maximum": 20 },
        "z": { "type": "number", "minimum": -20, "maximum": 20 }
      }
    },
    "primitiveSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": 0.05, "maximum": 20 },
        "y": { "type": "number", "minimum": 0.05, "maximum": 20 },
        "z": { "type": "number", "minimum": 0.05, "maximum": 20 }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "size", "color"],
      "properties": {
        "shape": { "enum": ["box", "cylinder", "sphere"] },
        "size": { "$ref": "#/$defs/primitiveSize" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "sceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "asset_id", "primitive", "position", "yaw_degrees", "scale"],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "maxLength": 64
        },
        "asset_id": {},
        "primitive": {},
        "position": { "$ref": "#/$defs/vector3" },
        "yaw_degrees": { "type": "number", "minimum": -360, "maximum": 360 },
        "scale": { "type": "number", "minimum": 0.1, "maximum": 5 }
      },
      "oneOf": [
        {
          "properties": {
            "asset_id": {
              "enum": [
                "airport-bench", "airport-counter", "airport-sign", "airport-suitcase",
                "cafe-chair", "cafe-counter", "cafe-cup", "cafe-table",
                "home-bookshelf", "home-lamp", "home-sofa", "home-table",
                "market-basket", "market-crate", "market-shelf"
              ]
            },
            "primitive": { "type": "null" }
          }
        },
        {
          "properties": {
            "asset_id": { "type": "null" },
            "primitive": { "$ref": "#/$defs/primitive" }
          }
        }
      ]
    },
    "sceneSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id", "environment_id", "camera_preset", "lighting_preset", "transition",
        "avatar_position", "avatar_yaw_degrees", "objects"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "maxLength": 64
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "maxLength": 64
        },
        "camera_preset": { "enum": ["counter", "conversation", "wide"] },
        "lighting_preset": { "enum": ["warm", "daylight", "terminal", "home"] },
        "transition": { "enum": ["fade", "cut"] },
        "avatar_position": { "$ref": "#/$defs/vector3" },
        "avatar_yaw_degrees": { "type": "number", "minimum": -360, "maximum": 360 },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/sceneObject" }
        }
      }
    },
    "speechEnergySample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_time_us", "level_milli"],
      "properties": {
        "media_time_us": { "type": "integer", "minimum": 0, "maximum": 30000000 },
        "level_milli": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "visemeCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viseme", "start_us", "end_us"],
      "properties": {
        "viseme": { "enum": ["silence", "closed", "open", "wide", "round", "teeth"] },
        "start_us": { "type": "integer", "minimum": 0, "maximum": 30000000 },
        "end_us": { "type": "integer", "minimum": 1, "maximum": 30000000 }
      }
    },
    "avatarAnimation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_us", "gesture", "expression", "viseme_source", "speech_energy", "visemes"
      ],
      "properties": {
        "duration_us": { "type": "integer", "minimum": 1, "maximum": 30000000 },
        "gesture": { "const": "speaking" },
        "expression": { "const": "encouraging" },
        "viseme_source": { "enum": ["provider_phoneme_alignment", "none"] },
        "speech_energy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 768,
          "items": { "$ref": "#/$defs/speechEnergySample" }
        },
        "visemes": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/visemeCue" }
        }
      }
    },
    "rendererAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "applied"],
      "properties": {
        "command_id": { "$ref": "#/$defs/uuid" },
        "applied": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "message": { "type": "string", "maxLength": 512 },
        "retryable": { "type": "boolean" },
        "session_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        }
      }
    }
  }
}
